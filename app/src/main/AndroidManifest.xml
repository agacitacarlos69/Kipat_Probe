<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kipat">

        <!-- Kipat product shell (Compose). singleTop so the armed tag writer's foreground
             dispatch is delivered to onNewIntent instead of stacking a new instance. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reveal host. Empty taskAffinity puts NFC launches in their own task so the
             translucent Reveal floats above whatever app the receiver was using, and
             finishing it returns straight to that app. -->
        <activity
            android:name=".TapExperienceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Kipat.Reveal">

            <!-- Debug / smoke-test route: adb shell am start -a android.intent.action.VIEW -d "kipatprobe://tap/TEST123" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="tap"
                    android:scheme="kipatprobe" />
            </intent-filter>

            <!-- Kipat Card taps. NDEF dispatch does not need App Links verification. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" />
                <data android:host="kipat.app" />
                <data android:pathPrefix="/c/" />
                <data android:pathPrefix="/tap/" />
                <data android:pathPrefix="/p/" />
            </intent-filter>

            <!-- Tags written by the original diagnostic probe (https://probe.kipat.com). -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="probe.kipat.com"
                    android:scheme="https" />
            </intent-filter>
        </activity>

    </application>

</manifest>
